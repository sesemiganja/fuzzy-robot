{
  "$schema": "https://raw.githubusercontent.com/miurla/morphic/main/public/config/models.schema.json",
  "defaultProvider": "openai",
  "providers": {
    "openai": {
      "name": "OpenAI",
      "enabled": true,
      "models": [
        {
          "id": "gpt-4o-mini",
          "label": "GPT-4o Mini",
          "capabilities": ["chat", "reasoning"],
          "notes": "Fast, cost-effective"
        },
        {
          "id": "gpt-4o",
          "label": "GPT-4o",
          "capabilities": ["chat", "vision", "reasoning"]
        }
      ],
      "envKeys": ["OPENAI_API_KEY"]
    },
    "thesys": {
      "name": "Thesys C1",
      "enabled": true,
      "models": [
        {
          "id": "c1/openai/gpt-5/v-20250915",
          "label": "C1 GPT-5 (2025-09-15)",
          "capabilities": ["chat", "streaming"]
        }
      ],
      "envKeys": ["THESYS_API_KEY"]
    }
  }
}